# Copy this file to config.env and fill it in. config.env is not committed.
# Every key can also be set as an environment variable.

# Token of the bot from @BotFather, like 123456789:AAH...xyz
TOKEN=

# Telegram ids of admins, separated by commas. Admins add tests and see everybody's results.
# Your id can be found with @userinfobot.
ADMINS=123456789

# SQLite file with tests and results, relative to this file
DATABASE=telexam.db
